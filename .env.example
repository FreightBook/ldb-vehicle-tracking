# ==============================================================
# LDB Vehicle Toll Tracking - Environment Configuration
# ==============================================================

# Server Port
PORT=5050

# MongoDB Connection String:
# - For Local MongoDB: mongodb://localhost:27017/ldb_tracker
# - For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ldb_tracker?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/ldb_tracker

# Toll tracking crawl interval in seconds (default: 1800 = 30 minutes)
POLL_INTERVAL_SECONDS=1800

# Application Access Passcode (shields website and API from unauthorized visitors)
APP_ACCESS_CODE=YOUR_ACCESS_PASSCODE

# LDB API endpoint for truck toll crossing logs
LDB_API_URL=https://ldb.co.in/api/ldbv2/truck/search

# Optional: Keep-Alive URL (Render sets RENDER_EXTERNAL_URL automatically)
# KEEP_ALIVE_URL=https://your-service.onrender.com/health

# Frontend client URL for CORS
CLIENT_ORIGIN=http://localhost:5173
