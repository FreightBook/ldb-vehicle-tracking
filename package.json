{
  "name": "ldb-vehicle-tracking",
  "version": "1.0.0",
  "description": "Full-cycle multi-day vehicle toll tracking using LDB with MongoDB Atlas",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "node server/index.js",
    "client": "npm --prefix client run dev",
    "dev": "concurrently -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"node server/index.js\" \"npm --prefix client run dev\"",
    "build": "npm --prefix client run build"
  },
  "dependencies": {
    "axios": "^1.7.9",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "mongoose": "^8.9.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.16.0"
  }
}
